{
  "compilerOptions": {
    "target": "ES2020",                // or ES2017+
    "module": "commonjs",              // or "esnext"
    "experimentalDecorators": true,    // ✅ required
    "emitDecoratorMetadata": true,     // ✅ optional but recommended
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "lib"                    // or wherever your build goes
  },
  "include": [
    "src/**/*"
  ]
}