{
  "private": true,
  "name": "experiment626",
  "version": "1.0.0",
  "description": "working on a galactic conquest game",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000",
    "generate-types": "node ./node_modules/@colyseus/schema/lib/codegen/cli.js src/rooms/schema/LobbyState.ts src/rooms/schema/GalaxyState.ts src/rooms/schema/StarState.ts src/rooms/schema/FleetState.ts src/rooms/schema/EmpireState.ts --ts --output ../experiment626-client/src/colyseusTypes --verbose"
  },
  "author": "Holland Francis, Scott Francis",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/sfrancisatx/experiment626/issues"
  },
  "homepage": "https://github.com/sfrancisatx/experiment626#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.16.0",
    "@colyseus/schema": "^3.0.39",
    "@colyseus/testing": "^0.16.0",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.30",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.10.2",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.16.0",
    "@colyseus/playground": "^0.16.0",
    "@colyseus/tools": "^0.16.0",
    "colyseus": "^0.16.0",
    "colyseus.js": "^0.16.15",
    "express": "^4.18.2"
  }
}
